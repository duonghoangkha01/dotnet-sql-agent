# Do not edit by hand. Run scripts/init-env.sh (or scripts/init-env.ps1): it copies this file to
# .env and fills each placeholder secret with a random value. .env is git-ignored.

# Compose profile "ollama" starts the local model. Set it empty to use Azure OpenAI only.
COMPOSE_PROFILES=ollama

# LLM provider: ollama | azure
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
# Context window. 8192 fits a GPU with ~3GB free VRAM; raise it on larger GPUs.
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KV_CACHE_TYPE=q8_0
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# Database secrets: one password per DB user, plus the SQL Server admin (sa).
MSSQL_SA_PASSWORD=__GENERATE__
SQL_SALES_REP_PASSWORD=__GENERATE__
SQL_FINANCE_PASSWORD=__GENERATE__
SQL_ADMIN_PASSWORD=__GENERATE__
SQL_APP_PASSWORD=__GENERATE__

# API token signing key.
JWT_SIGNING_KEY=__GENERATE__
# Demo logins: POST /api/auth/demo-token hands out a token for a fixed persona. Turn off for anything public.
DEMO_AUTH=true
# What the model itself sees of a query result: None (columns and row count), Summary (plus 5 rows) or Rows (up to 50).
# The user always sees the full result. Use None for data that must not reach an LLM provider.
RESULT_VISIBILITY=Summary
